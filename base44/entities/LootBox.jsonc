{
  "name": "LootBox",
  "type": "object",
  "properties": {
    "box_id": {
      "type": "string",
      "description": "ID \u00fanico de la caja"
    },
    "name": {
      "type": "string",
      "description": "Nombre de la caja"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n de la caja"
    },
    "icon": {
      "type": "string",
      "description": "Emoji de la caja"
    },
    "price": {
      "type": "number",
      "description": "Precio en monedas"
    },
    "gem_price": {
      "type": "number",
      "description": "Precio alternativo en gemas"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary",
        "exclusive"
      ],
      "default": "common",
      "description": "Rareza de la caja"
    },
    "color_gradient": {
      "type": "string",
      "description": "Clases de gradiente CSS"
    },
    "possible_rarities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rarezas posibles de items"
    },
    "item_count": {
      "type": "number",
      "default": 3,
      "description": "Cantidad de items por caja"
    },
    "guaranteed_legendary": {
      "type": "boolean",
      "default": false,
      "description": "Si garantiza un item legendario"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Si est\u00e1 disponible"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n"
    }
  },
  "required": [
    "box_id",
    "name",
    "description",
    "price",
    "possible_rarities",
    "item_count"
  ]
}