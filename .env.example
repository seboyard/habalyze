# local: datos de demostración en el navegador.
# supabase: Auth y Postgres. Si faltan URL o clave, la app vuelve a local.
VITE_DATA_ADAPTER=local

# Placeholders. No pongas la clave real en git.
# En Vercel ya deben existir como variables de entorno.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base44 ya no hace falta para desarrollar.
VITE_BASE44_APP_ID=
VITE_BASE44_BACKEND_URL=
VITE_BASE44_APP_BASE_URL=
