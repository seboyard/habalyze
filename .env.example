# Adaptador de datos. `local` guarda todo en el navegador.
# `supabase` queda preparado, pero esta rama no crea un proyecto.
VITE_DATA_ADAPTER=local

# Solo si más adelante se conecta Supabase. Déjalos vacíos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base44 ya no es necesario para desarrollar. Placeholders por si se reenlaza.
VITE_BASE44_APP_ID=
VITE_BASE44_BACKEND_URL=
VITE_BASE44_APP_BASE_URL=
