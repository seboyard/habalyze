{
  "name": "ShopItem",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "ID \u00fanico del item"
    },
    "name": {
      "type": "string",
      "description": "Nombre del item"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del item"
    },
    "category": {
      "type": "string",
      "enum": [
        "skin",
        "hair_style",
        "hair_color",
        "face",
        "glasses",
        "hat",
        "shirt",
        "pants",
        "shoes",
        "scarf",
        "gloves",
        "backpack",
        "tattoo",
        "piercing",
        "pet",
        "effect"
      ],
      "description": "Categor\u00eda del item"
    },
    "style_id": {
      "type": "string",
      "description": "ID del estilo en el avatar"
    },
    "color": {
      "type": "string",
      "description": "Color del item si aplica"
    },
    "customizable": {
      "type": "boolean",
      "default": false,
      "description": "Si permite personalizaci\u00f3n de color"
    },
    "customizable_colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Colores disponibles para personalizaci\u00f3n"
    },
    "price": {
      "type": "number",
      "description": "Precio en monedas"
    },
    "gem_price": {
      "type": "number",
      "description": "Precio alternativo en gemas"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary",
        "exclusive"
      ],
      "default": "common",
      "description": "Rareza del item"
    },
    "icon": {
      "type": "string",
      "description": "Emoji o icono del item"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Si el item est\u00e1 disponible"
    },
    "is_limited": {
      "type": "boolean",
      "default": false,
      "description": "Si es edici\u00f3n limitada"
    },
    "limited_until": {
      "type": "string",
      "format": "date",
      "description": "Fecha hasta la cual est\u00e1 disponible si es limitado"
    },
    "is_new": {
      "type": "boolean",
      "default": false,
      "description": "Si es nuevo (\u00faltimos 7 d\u00edas)"
    },
    "added_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se a\u00f1adi\u00f3 al cat\u00e1logo"
    },
    "sales_count": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de veces vendido"
    },
    "unlock_requirement": {
      "type": "object",
      "description": "Requisitos para desbloquear",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "level",
            "streak",
            "achievement",
            "challenge",
            "event",
            "badge",
            "none"
          ]
        },
        "value": {
          "type": "string",
          "description": "Valor del requisito (nivel, ID de logro, badge_id, etc.)"
        }
      }
    },
    "unlock_source": {
      "type": "string",
      "enum": [
        "shop",
        "achievement",
        "event",
        "challenge",
        "badge_reward",
        "premium",
        "lootbox"
      ],
      "default": "shop",
      "description": "De d\u00f3nde se obtiene este item"
    },
    "preview_config": {
      "type": "object",
      "description": "Configuraci\u00f3n para preview del avatar"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Etiquetas para b\u00fasqueda y filtrado"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n en la tienda"
    }
  },
  "required": [
    "item_id",
    "name",
    "category",
    "price",
    "icon"
  ]
}