{
  "name": "ProjectWeekStatus",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID del proyecto al que pertenece esta semana"
    },
    "week_number": {
      "type": "number",
      "description": "N\u00famero de la semana del proyecto (1-52)"
    },
    "year": {
      "type": "number",
      "description": "A\u00f1o de la semana"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio de la semana"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin de la semana"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "missed"
      ],
      "default": "pending",
      "description": "Estado de la semana"
    },
    "tasks_completed_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de tareas completadas en esta semana"
    },
    "total_tasks_count": {
      "type": "number",
      "default": 0,
      "description": "Total de tareas asignadas a esta semana"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "Porcentaje de progreso de la semana (0-100)"
    }
  },
  "required": [
    "project_id",
    "week_number",
    "year",
    "start_date",
    "end_date"
  ]
}